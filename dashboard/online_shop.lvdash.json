{
 "datasets": [
  {
   "name": "kpis",
   "displayName": "kpis",
   "queryLines": [
    "SELECT SUM(revenue) AS total_revenue,\n               SUM(order_count) AS total_orders,\n               SUM(revenue) / SUM(order_count) AS avg_order_value\n        FROM workspace.mustafa_shop.gold_monthly_sales"
   ]
  },
  {
   "name": "customers",
   "displayName": "customers",
   "queryLines": [
    "SELECT COUNT(*) AS customers\n        FROM workspace.mustafa_shop.gold_customer_features"
   ]
  },
  {
   "name": "monthly",
   "displayName": "monthly",
   "queryLines": [
    "SELECT month, SUM(revenue) AS revenue\n        FROM workspace.mustafa_shop.gold_monthly_sales\n        WHERE month <= '2026-09'\n        GROUP BY month"
   ]
  },
  {
   "name": "city",
   "displayName": "city",
   "queryLines": [
    "SELECT city, SUM(revenue) AS revenue\n        FROM workspace.mustafa_shop.gold_monthly_sales\n        GROUP BY city"
   ]
  },
  {
   "name": "category",
   "displayName": "category",
   "queryLines": [
    "SELECT category,\n               SUM(revenue) AS revenue,\n               SUM(revenue) / SUM(order_count) AS avg_order_value\n        FROM workspace.mustafa_shop.gold_category_mix\n        GROUP BY category"
   ]
  },
  {
   "name": "growth",
   "displayName": "growth",
   "queryLines": [
    "SELECT city,\n               ROUND((SUM(CASE WHEN month BETWEEN '2026-01' AND '2026-09' THEN revenue END)\n                    / SUM(CASE WHEN month BETWEEN '2025-01' AND '2025-09' THEN revenue END) - 1) * 100, 2)\n                    AS revenue_growth_pct\n        FROM workspace.mustafa_shop.gold_monthly_sales\n        GROUP BY city\n        ORDER BY revenue_growth_pct DESC"
   ]
  },
  {
   "name": "rain",
   "displayName": "rain",
   "queryLines": [
    "SELECT city,\n               ROUND(AVG(CASE WHEN is_rainy THEN orders_placed END), 2) AS rainy_day_orders,\n               ROUND(AVG(CASE WHEN NOT is_rainy THEN orders_placed END), 2) AS dry_day_orders\n        FROM workspace.mustafa_shop.gold_city_weather_daily\n        GROUP BY city\n        ORDER BY city"
   ]
  }
 ],
